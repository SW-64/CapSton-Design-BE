// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  userId       Int           @id @default(autoincrement())
  email        String        @unique
  password     String
  name         String
  nickName     String
  profile      String
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  interactions Interaction[]
  Spot         Spot[]

  @@map("users")
}

model Spot {
  spotId      Int           @id @default(autoincrement())
  userId      Int
  spotName    String
  imageUrl    Json?         @map("image_url")
  isPublic    IsPublic      @default(PUBLIC)
  extraInfo   String
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  interaction Interaction[]

  user         User           @relation(fields: [userId], references: [userId])
  SpotCategory SpotCategory[]

  @@map("spots")
}

model Category {
  categoryId   Int            @id @default(autoincrement())
  name         String
  isCustom     Boolean        @default(false)
  SpotCategory SpotCategory[]

  @@map("categories")
}

model SpotCategory {
  spotCategoryId Int      @id @default(autoincrement())
  spotId         Int      @map("spot_id")
  categoryId     Int      @map("category_id")
  spot           Spot     @relation(fields: [spotId], references: [spotId])
  category       Category @relation(fields: [categoryId], references: [categoryId])

  @@index([categoryId, spotId])
  @@map("spot_categories")
}

model Interaction {
  interactionId Int             @id @default(autoincrement())
  spotId        Int
  userId        Int
  type          InteractionType @default(BOOKMARK)
  spot          Spot            @relation(fields: [spotId], references: [spotId])
  user          User            @relation(fields: [userId], references: [userId])

  @@index([userId, type])
  @@map("interactions")
}

enum IsPublic {
  PUBLIC
  PRIVATE
}

enum InteractionType {
  LIKE
  BOOKMARK
}
